@page
@model AdministracionSolicitudes.Web.Pages.Reportes.FacturacionMensualModel
@{ ViewData["Title"] = "Facturacion mensual"; }

<section class="mantenimiento">
    <div class="cabecera-mantenimiento"><h1>Reporte de Facturacion Mensual</h1></div>

    <div class="panel-formulario mb-4">
        <div class="titulo-panel">Parametros del reporte</div>
        <form method="get" class="campos-formulario rejilla-campos">
            <div class="campo-formulario">
                <label for="mes">Mes</label>
                <select id="mes" name="Mes" required>
                    <option value="">-- Seleccione --</option>
                    @for (var mes = 1; mes <= 12; mes++) { <option value="@mes" selected="@(Model.Mes == mes)">@mes</option> }
                </select>
            </div>
            <div class="campo-formulario"><label for="anio">Año</label><input id="anio" name="Anio" type="number" min="1" max="9999" value="@Model.Anio" required /></div>
            <div class="campo-formulario"><button type="submit" class="boton-nuevo"><i class="bi bi-search"></i><span>Generar</span></button></div>
        </form>
    </div>

    @if (Model.Generado)
    {
        <div class="panel-informacion">
            <div class="titulo-panel">Informacion</div>
            <div class="contenedor-tabla">
                <table class="tabla-mantenimiento">
                    <thead><tr><th>Consecutivo</th><th>Titulo</th><th>Mes</th><th>Año</th><th>Monto</th><th>IVA</th><th>Total por solicitud</th></tr></thead>
                    <tbody>
                    @foreach (var registro in Model.Registros)
                    {
                        <tr><td>@registro.ConsecutivoOficio</td><td>@registro.Titulo</td><td>@registro.Mes</td><td>@registro.Anio</td><td>@registro.Monto.ToString("N2")</td><td>@registro.Iva.ToString("N2")</td><td>@registro.Total.ToString("N2")</td></tr>
                    }
                    @if (!Model.Registros.Any()) { <tr><td colspan="7" class="sin-registros">No hay montos para el mes y año seleccionados.</td></tr> }
                    </tbody>
                    <tfoot><tr><th colspan="4">Totales</th><th>@Model.TotalMonto.ToString("N2")</th><th>@Model.TotalIva.ToString("N2")</th><th>@Model.TotalGeneral.ToString("N2")</th></tr></tfoot>
                </table>
            </div>
        </div>
    }
</section>

@section Scripts {
@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <script>Swal.fire({ text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeError)), icon: 'warning', confirmButtonText: 'Aceptar' });</script>
}
}
