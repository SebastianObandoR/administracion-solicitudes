@page
@model AdministracionSolicitudes.Web.Pages.Solicitudes.FormModel

@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Solicitud" : "Nueva Solicitud";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
</div>

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<form method="post" class="row g-3">
    <input type="hidden" asp-for="Input.IdSolicitud" />

    <div class="col-md-4">
        <label asp-for="Input.ConsecutivoOficio" class="form-label">Consecutivo de oficio</label>
        <input asp-for="Input.ConsecutivoOficio" class="form-control" />
        <span asp-validation-for="Input.ConsecutivoOficio" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Input.Titulo" class="form-label">Titulo</label>
        <input asp-for="Input.Titulo" class="form-control" />
        <span asp-validation-for="Input.Titulo" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.IdRepresentante" class="form-label">Representante</label>
        <select asp-for="Input.IdRepresentante" asp-items="Model.Representantes" class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Input.IdRepresentante" class="text-danger"></span>
    </div>

    @if (Model.EsEdicion)
    {
        <div class="col-md-6">
            <label asp-for="Input.IdEstado" class="form-label">Estado</label>
            <select asp-for="Input.IdEstado" asp-items="Model.Estados" class="form-select"></select>
            <span asp-validation-for="Input.IdEstado" class="text-danger"></span>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <label class="form-label">Estado</label>
            <input type="text" class="form-control" value="Nueva" disabled />
            <div class="form-text">Las solicitudes se crean por defecto en estado "Nueva".</div>
        </div>
    }

    <div class="col-md-6">
        <label asp-for="Input.FechaIngreso" class="form-label">Fecha de ingreso</label>
        <input asp-for="Input.FechaIngreso" class="form-control" type="date" />
        <span asp-validation-for="Input.FechaIngreso" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.Descripcion" class="form-label">Descripcion</label>
        <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="col-12">
        <label asp-for="Input.Observaciones" class="form-label">Observaciones</label>
        <textarea asp-for="Input.Observaciones" class="form-control" rows="2"></textarea>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.DocumentoInicio" class="form-label">Documento de inicio</label>
        <input asp-for="Input.DocumentoInicio" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="Input.DocumentoRespuesta" class="form-label">Documento de respuesta</label>
        <input asp-for="Input.DocumentoRespuesta" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="Input.FechaInicio" class="form-label">Fecha de inicio</label>
        <input asp-for="Input.FechaInicio" class="form-control" type="date" />
    </div>

    <div class="col-md-6">
        <label asp-for="Input.FechaRespuesta" class="form-label">Fecha de respuesta</label>
        <input asp-for="Input.FechaRespuesta" class="form-control" type="date" />
    </div>

    <div class="col-12 d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Guardar
        </button>
        <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
