@page
@model AdministracionSolicitudes.Web.Pages.Usuarios.EditarModel
@using AdministracionSolicitudes.Entities

@{
    ViewData["Title"] = "Editar Usuario";
}

<section class="formulario-mantenimiento">
    <div class="acciones-formulario">
        <a asp-page="/Usuarios/Index" class="boton-formulario" title="Regresar">
            <i class="bi bi-arrow-left"></i>
        </a>

        <button type="submit" form="formUsuario" class="boton-formulario" title="Guardar">
            <i class="bi bi-floppy-fill"></i>
        </button>
    </div>

    <div class="panel-formulario">
        <div class="titulo-panel">Formulario Usuario</div>

        <form method="post" id="formUsuario" class="campos-formulario">
            <input asp-for="IdUsuario" type="hidden" />

            <div class="campo-formulario">
                <label asp-for="Usuario.NombreUsuario">Nombre de usuario</label>
                <input asp-for="Usuario.NombreUsuario" autocomplete="off" />
            </div>

            <div class="campo-formulario">
                <label asp-for="Usuario.NombreCompleto">Nombre completo</label>
                <input asp-for="Usuario.NombreCompleto" autocomplete="off" />
            </div>

            <div class="campo-formulario">
                <label asp-for="Usuario.Correo">Correo</label>
                <input asp-for="Usuario.Correo" type="email" autocomplete="off" />
            </div>

            <div class="campo-formulario">
                <label asp-for="Usuario.Contrasena">Contrasena</label>
                <input asp-for="Usuario.Contrasena" type="password" autocomplete="new-password" />
            </div>

            <div class="campo-formulario">
                <label asp-for="Usuario.Estado">Estado</label>
                <select asp-for="Usuario.Estado">
                    <option value="@EstadoUsuario.Activo">Activo</option>
                    <option value="@EstadoUsuario.Inactivo">Inactivo</option>
                    <option value="@EstadoUsuario.Bloqueado">Bloqueado</option>
                </select>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @if (TempData["MensajeFormulario"] is string mensaje)
    {
        <script>
            Swal.fire({
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensaje)),
                icon: "error",
                confirmButtonText: "Aceptar"
            });
        </script>
    }
}