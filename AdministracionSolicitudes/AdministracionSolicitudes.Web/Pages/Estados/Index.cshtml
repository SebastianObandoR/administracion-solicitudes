@page
@model AdministracionSolicitudes.Web.Pages.Estados.IndexModel

@{
    ViewData["Title"] = "Estados de solicitudes";
}

<section class="mantenimiento">
    <div class="cabecera-mantenimiento">
        <h1>Administracion de Estados de Solicitud</h1>

        <a asp-page="Crear" class="boton-nuevo">
            <i class="bi bi-file-earmark-plus-fill"></i>
            <span>Nuevo</span>
        </a>
    </div>

    <div class="estados-tarjeta">
        <div class="table-responsive">
            <table class="table estados-tabla align-middle mb-0">
                <thead>
                    <tr>
                        <th>Identificador</th>
                        <th>Nombre</th>
                        <th class="columna-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Resultado.Estados.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="sin-registros">No hay estados para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var estado in Model.Resultado.Estados)
                        {
                            <tr>
                                <td>@estado.IdEstado</td>
                                <td>@estado.Nombre</td>
                                <td class="acciones">
                                    <a asp-page="/Estados/Editar"
                                       asp-route-id="@estado.IdEstado"
                                       class="boton-accion"
                                       title="Editar"
                                       aria-label="Editar estado @estado.Nombre">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button"
                                            class="boton-accion boton-eliminar"
                                            data-id="@estado.IdEstado"
                                            data-pagina="@Model.Resultado.Pagina"
                                            title="Eliminar"
                                            aria-label="Eliminar estado @estado.Nombre">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Resultado.TotalPaginas > 1)
    {
        <div class="paginacion">
            @for (var pagina = 1; pagina <= Model.Resultado.TotalPaginas; pagina++)
            {
                <a asp-page="/Estados/Index"
                   asp-route-pagina="@pagina"
                   class="pagina @(pagina == Model.Resultado.Pagina ? "pagina-activa" : string.Empty)">
                    @pagina
                </a>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
        {
            <text>
                Swal.fire({
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeExito)),
                    icon: "success",
                    confirmButtonText: "Aceptar"
                });
            </text>
        }
        else if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <text>
                Swal.fire({
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeError)),
                    icon: "error",
                    confirmButtonText: "Aceptar"
                });
            </text>
        }
    </script>
}
