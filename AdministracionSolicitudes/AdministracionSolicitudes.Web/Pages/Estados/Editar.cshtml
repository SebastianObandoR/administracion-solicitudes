@page "{id:int}"
@model AdministracionSolicitudes.Web.Pages.Estados.EditarModel
@using System.Linq

@{
    ViewData["Title"] = "Editar estado";
    var erroresServidor = ViewData.ModelState.Values
        .SelectMany(estado => estado.Errors)
        .Select(error => error.ErrorMessage)
        .Where(mensaje => !string.IsNullOrWhiteSpace(mensaje))
        .Distinct()
        .ToArray();
}

<section class="formulario-mantenimiento">
    <div class="acciones-formulario">
        <a asp-page="/Estados/Index" class="boton-formulario" title="Regresar">
            <i class="bi bi-arrow-left"></i>
        </a>

        <button type="submit" form="formEstado" class="boton-formulario" title="Guardar">
            <i class="bi bi-floppy-fill"></i>
        </button>
    </div>

    <div class="panel-formulario">
        <div class="titulo-panel">Formulario Estado de Solicitud</div>

        <form method="post" id="formEstado" class="campos-formulario" novalidate>
            <div class="campo-formulario">
                <label asp-for="Id">Identificador</label>
                <input asp-for="Id" readonly />
            </div>

            <div class="campo-formulario">
                <label asp-for="Input.Nombre">Nombre</label>
                <input asp-for="Input.Nombre" autocomplete="off" />
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function mostrarErroresFormulario(mensajes, icono, titulo) {
            const lista = document.createElement("ul");
            lista.style.textAlign = "left";
            lista.style.margin = "0";
            lista.style.paddingLeft = "20px";

            mensajes.forEach(mensaje => {
                const elemento = document.createElement("li");
                elemento.textContent = mensaje;
                lista.appendChild(elemento);
            });

            Swal.fire({
                title: titulo,
                html: lista,
                icon: icono,
                confirmButtonText: "Aceptar",
                confirmButtonColor: "#2d7a78"
            });
        }

        $(function () {
            const formulario = $("#formEstado");
            const validador = formulario.data("validator");

            if (validador) {
                validador.settings.errorPlacement = function () { };
                validador.settings.invalidHandler = function (event, validadorFormulario) {
                    const mensajes = [...new Set(validadorFormulario.errorList.map(error => error.message))];
                    mostrarErroresFormulario(mensajes, "warning", "Campos obligatorios");
                };
            }
        });

        const erroresServidor = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(erroresServidor));
        if (erroresServidor.length > 0) {
            mostrarErroresFormulario(erroresServidor, "error", "");
        }
    </script>
}
