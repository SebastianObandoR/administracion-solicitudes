@page "/detalle-solicitud"
@model AdministracionSolicitudes.Web.Pages.DetalleSolicitudModel
@{
    Layout = null;
    ViewData["Title"] = "Detalle de la solicitud";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/sitio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mantenimientos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/detalle-solicitud.css" asp-append-version="true" />
</head>
<body>
    <main class="publicasa-solicitudes-wrapper">
        <header class="publicasa-solicitudes-header">
            <p class="publicasa-solicitudes-subtitle">Detalle de la solicitud</p>
        </header>

        <div class="publicasa-detalle-contenedor">
            <table class="publicasa-detalle">
                <tbody>
                    <tr>
                        <th scope="row">Consecutivo de oficio</th>
                        <td>@Model.Solicitud!.ConsecutivoOficio</td>
                    </tr>
                    <tr>
                        <th scope="row">Documento de respuesta</th>
                        <td>
                            @if (Model.Solicitud.DocumentoRespuesta is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.DocumentoRespuesta
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Documento de inicio</th>
                        <td>
                            @if (Model.Solicitud.DocumentoInicio is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.DocumentoInicio
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Título de la solicitud</th>
                        <td>@Model.Solicitud.Titulo</td>
                    </tr>
                    <tr>
                        <th scope="row">Descripción</th>
                        <td>
                            @if (Model.Solicitud.Descripcion is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.Descripcion
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Representante</th>
                        <td>
                            @if (Model.Solicitud.NombreRepresentante is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.NombreRepresentante
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Observaciones</th>
                        <td>
                            @if (Model.Solicitud.Observaciones is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.Observaciones
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Estado de la solicitud</th>
                        <td>
                            @if (Model.Solicitud.NombreEstado is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.NombreEstado
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Fecha de ingreso</th>
                        <td>@Model.Solicitud.FechaIngreso.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <th scope="row">Fecha de respuesta</th>
                        <td>
                            @if (Model.Solicitud.FechaRespuesta is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.FechaRespuesta.Value.ToString("dd/MM/yyyy")
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Fecha de inicio</th>
                        <td>
                            @if (Model.Solicitud.FechaInicio is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.FechaInicio.Value.ToString("dd/MM/yyyy")
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Fecha de vencimiento de la publicación</th>
                        <td>
                            @if (Model.Solicitud.FechaVencimientoPublicacion is null)
                            {
                                <em>&lt;No indicado&gt;</em>
                            }
                            else
                            {
                                @Model.Solicitud.FechaVencimientoPublicacion.Value.ToString("dd/MM/yyyy")
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <nav class="publicasa-acciones" aria-label="Acciones de la solicitud">
            <a href="/solicitudes-publicadas" class="boton-nuevo">Regresar</a>
            @* Placeholder para la ruta de HU EXT4; esa pantalla no se implementa aquí. *@
            <a href="/participar?idSolicitud=@Model.Solicitud.IdSolicitud" class="boton-nuevo">Participar</a>
        </nav>
    </main>
</body>
</html>
