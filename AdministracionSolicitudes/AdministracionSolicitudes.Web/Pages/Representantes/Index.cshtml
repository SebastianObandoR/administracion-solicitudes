@page
@model AdministracionSolicitudes.Web.Pages.Representantes.IndexModel

@{
    ViewData["Title"] = "Representantes";
}

<section class="mantenimiento">
    <div class="cabecera-mantenimiento">
        <h1>Administracion de Representantes</h1>

        <a asp-page="Crear" class="boton-nuevo">
            <i class="bi bi-file-earmark-plus-fill"></i>
            <span>Nuevo</span>
        </a>
    </div>

    <div class="panel-informacion">
        <div class="titulo-panel">Informacion</div>

        <div class="contenedor-tabla">
            <table class="tabla-mantenimiento">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th class="columna-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Resultado.Representantes.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="sin-registros">No hay representantes para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var representante in Model.Resultado.Representantes)
                        {
                            <tr>
                                <td>@representante.Nombre</td>
                                <td>@representante.Correo</td>
                                <td class="acciones">
                                    <a asp-page="/Representantes/Editar"
                                       asp-route-id="@representante.IdRepresentante"
                                       class="boton-accion"
                                       title="Editar"
                                       aria-label="Editar representante @representante.Nombre">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button"
                                            class="boton-accion boton-eliminar"
                                            data-id="@representante.IdRepresentante"
                                            data-pagina="@Model.Resultado.Pagina"
                                            title="Eliminar"
                                            aria-label="Eliminar representante @representante.Nombre">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Resultado.TotalPaginas > 1)
    {
        <div class="paginacion">
            @for (var pagina = 1; pagina <= Model.Resultado.TotalPaginas; pagina++)
            {
                <a asp-page="/Representantes/Index"
                   asp-route-pagina="@pagina"
                   class="pagina @(pagina == Model.Resultado.Pagina ? "pagina-activa" : string.Empty)">
                    @pagina
                </a>
            }
        </div>
    }
</section>

<form method="post" asp-page-handler="Eliminar" id="formEliminarRepresentante">
    <input type="hidden" name="id" id="idRepresentanteEliminar" />
    <input type="hidden" name="pagina" id="paginaRepresentanteEliminar" />
</form>

@section Scripts {
    <script>
        document.querySelectorAll(".boton-eliminar").forEach(boton => {
            boton.addEventListener("click", () => {
                Swal.fire({
                    title: "Confirmar eliminacion",
                    text: "¿Realmente desea eliminar el elemento seleccionado?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Si",
                    cancelButtonText: "No"
                }).then(resultado => {
                    if (!resultado.isConfirmed) return;
                    document.getElementById("idRepresentanteEliminar").value = boton.dataset.id;
                    document.getElementById("paginaRepresentanteEliminar").value = boton.dataset.pagina;
                    document.getElementById("formEliminarRepresentante").submit();
                });
            });
        });

        @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
        {
            <text>
                Swal.fire({
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeExito)),
                    icon: "success",
                    confirmButtonText: "Aceptar"
                });
            </text>
        }
        else if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <text>
                Swal.fire({
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeError)),
                    icon: "error",
                    confirmButtonText: "Aceptar"
                });
            </text>
        }
    </script>
}
