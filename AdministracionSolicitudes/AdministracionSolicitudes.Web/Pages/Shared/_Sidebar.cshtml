@{
    var systemName = ViewData["SystemName"]?.ToString() ?? "Administración de Solicitudes";

    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var isHome = currentPath == "/" || currentPath == "/index";
}

<aside class="panel-lateral">
    <div class="area-marca">
        <img src="~/images/application-icon.svg" class="icono-marca" alt="Icono de Administracion de Solicitudes" />
        <span class="nombre-marca">@systemName</span>
    </div>

    <nav class="navegacion-principal" aria-label="Navegacion principal">
        <div class="grupo-navegacion">
            <span class="titulo-grupo">General</span>

            <a class="elemento-navegacion @(isHome ? "esta-activo" : string.Empty)" asp-page="/Index" title="Inicio">
                <span class="numero-navegacion">01</span>
                <span class="texto-navegacion">Inicio</span>
            </a>
        </div>

        <div class="grupo-navegacion">
            <span class="titulo-grupo">Gestion</span>

            <span class="elemento-navegacion esta-pendiente" title="Solicitudes">
                <span class="numero-navegacion">02</span>
                <span class="texto-navegacion">Solicitudes</span>
            </span>

            <span class="elemento-navegacion esta-pendiente" title="Tareas">
                <span class="numero-navegacion">03</span>
                <span class="texto-navegacion">Tareas</span>
            </span>
        </div>

        <div class="grupo-navegacion">
            <span class="titulo-grupo">Administracion</span>

            <span class="elemento-navegacion esta-pendiente" title="Usuarios">
                <span class="numero-navegacion">04</span>
                <span class="texto-navegacion">Usuarios</span>
            </span>

            <span class="elemento-navegacion esta-pendiente" title="Representantes">
                <span class="numero-navegacion">05</span>
                <span class="texto-navegacion">Representantes</span>
            </span>

            <span class="elemento-navegacion esta-pendiente" title="Estados">
                <span class="numero-navegacion">06</span>
                <span class="texto-navegacion">Estados</span>
            </span>
        </div>

        <div class="grupo-navegacion">
            <span class="titulo-grupo">Consultas</span>

            <span class="elemento-navegacion esta-pendiente" title="Reportes">
                <span class="numero-navegacion">07</span>
                <span class="texto-navegacion">Reportes</span>
            </span>
        </div>
    </nav>

    <div class="pie-lateral">
        <span>ASP.NET 8</span>
        <span>v1.0</span>
    </div>
</aside>