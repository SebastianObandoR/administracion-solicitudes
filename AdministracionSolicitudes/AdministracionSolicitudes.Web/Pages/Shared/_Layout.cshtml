@using AdministracionSolicitudes.Web.Constants
@inject IConfiguration Configuration

@{
    var systemName = Configuration["ConfiguracionSistema:Nombre"] ?? "Administracion de Solicitudes";
    var userName = Context.Session.GetString(SessionKeys.FullName) ?? "Usuario";

    ViewData["SystemName"] = systemName;
    ViewData["LayoutUserName"] = userName;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @systemName</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/sitio.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/estructura.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/navegacion.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/paginas.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/mantenimientos.css" asp-append-version="true" />
</head>

<body>
    <div class="espacio-trabajo" id="espacioTrabajo">
        <partial name="_Sidebar" />

        <div class="contenido-trabajo">
            <partial name="_Topbar" />

            <main class="contenido-pagina">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/estructura.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>