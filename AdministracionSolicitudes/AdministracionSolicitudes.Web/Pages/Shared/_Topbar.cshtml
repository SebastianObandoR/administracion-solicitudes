@{
    var userName = ViewData["LayoutUserName"]?.ToString() ?? "Usuario";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Inicio";
}

<header class="panel-superior">
    <div class="contexto-pagina">
        <span class="etiqueta-contexto">Area de trabajo</span>
        <span class="titulo-contexto">@pageTitle</span>
    </div>

    <div class="area-perfil">
        <div class="informacion-perfil">
            <span class="etiqueta-perfil">Sesion actual</span>
            <span class="nombre-perfil">@userName</span>
        </div>

        <div class="marca-perfil" title="@userName">
            <i class="bi bi-person icono-usuario"></i>
        </div>
    </div>
</header>