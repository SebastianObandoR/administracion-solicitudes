@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<section class="bienvenida">
    <div class="bienvenida-contenido">
        <span class="bienvenida-etiqueta">Administracion de Solicitudes</span>

        <h1>Bienvenido, @Model.FullName</h1>

        <p>Desde este espacio puede acceder a las diferentes opciones disponibles para la gestion y seguimiento de solicitudes.</p>
    </div>

    <div class="bienvenida-marca">
        <img src="~/images/application-icon.svg" alt="Logo de la empresa" />
    </div>
</section>