@page
@using AdministracionSolicitudes.Services.Models
@model AdministracionSolicitudes.Web.Pages.MantenimientoSolicitudes.IndexModel

@{
    ViewData["Title"] = "Solicitudes";
}

<section class="mantenimiento">
    <div class="cabecera-mantenimiento">
        <h1>Administracion de Solicitudes</h1>

        <a asp-page="/MantenimientoSolicitudes/Crear" class="boton-nuevo">
            <i class="bi bi-file-earmark-plus-fill"></i>
            <span>Nuevo</span>
        </a>
    </div>

    <div class="panel-informacion">
        <div class="titulo-panel">Informacion</div>

        <div class="contenedor-tabla">
            <table class="tabla-mantenimiento">
                <thead>
                    <tr>
                        <th>Consecutivo</th>
                        <th>Titulo</th>
                        <th>Representante</th>
                        <th>Estado</th>
                        <th>Fecha ingreso</th>
                        <th>Fecha respuesta</th>
                        <th>Publicacion</th>
                        <th class="columna-acciones">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var solicitud in Model.Solicitudes)
                    {
                        var vencimiento = Model.EstadosVencimiento[solicitud.IdSolicitud];

                        string filaClase = vencimiento switch
                        {
                            EstadoVencimiento.Vencida => "fila-vencida",
                            EstadoVencimiento.VenceHoy => "fila-vence-hoy",
                            EstadoVencimiento.Nueva => "fila-al-dia",
                            _ => "fila-sin-color"
                        };

                        bool publicacionVigente =
                            solicitud.Publicada &&
                            solicitud.FechaVencimientoPublicacion.HasValue &&
                            solicitud.FechaVencimientoPublicacion.Value.Date >= DateTime.Today;

                        bool publicacionVencida =
                            solicitud.Publicada &&
                            solicitud.FechaVencimientoPublicacion.HasValue &&
                            solicitud.FechaVencimientoPublicacion.Value.Date < DateTime.Today;

                        <tr class="@filaClase">
                            <td>@solicitud.ConsecutivoOficio</td>
                            <td>@solicitud.Titulo</td>
                            <td>@solicitud.NombreRepresentante</td>
                            <td>@solicitud.NombreEstado</td>
                            <td>@solicitud.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td>@(solicitud.FechaRespuesta?.ToString("dd/MM/yyyy") ?? "-")</td>

                            <td>
                                @if (publicacionVigente)
                                {
                                    <span>
                                        Publicada hasta
                                        @solicitud.FechaVencimientoPublicacion!.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else if (publicacionVencida)
                                {
                                    <span>
                                        Publicacion vencida
                                        @solicitud.FechaVencimientoPublicacion!.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span>No publicada</span>
                                }
                            </td>

                            <td class="acciones">
                                <a asp-page="/Desgloses/Index"
                                   asp-route-idSolicitud="@solicitud.IdSolicitud"
                                   class="boton-accion"
                                   title="Desglose">
                                    <i class="bi bi-receipt"></i>
                                    <span class="visually-hidden">Desglose</span>
                                </a>

                                <a asp-page="/Tareas/Index"
                                   asp-route-idSolicitud="@solicitud.IdSolicitud"
                                   class="boton-accion"
                                   title="Tareas">
                                    <i class="bi bi-list-task"></i>
                                    <span class="visually-hidden">Tareas</span>
                                </a>

                                @if (publicacionVigente)
                                {
                                    <button type="button"
                                            class="boton-accion boton-despublicar"
                                            data-id="@solicitud.IdSolicitud"
                                            data-nombre="@solicitud.Titulo"
                                            title="Despublicar">
                                        <i class="bi bi-eye-slash-fill"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="boton-accion boton-publicar"
                                            data-id="@solicitud.IdSolicitud"
                                            data-nombre="@solicitud.Titulo"
                                            title="Publicar">
                                        <i class="bi bi-cloud-arrow-up-fill"></i>
                                    </button>
                                }

                                <a asp-page="/MantenimientoSolicitudes/Editar"
                                   asp-route-id="@solicitud.IdSolicitud"
                                   class="boton-accion"
                                   title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <button type="button"
                                        class="boton-accion boton-eliminar"
                                        data-id="@solicitud.IdSolicitud"
                                        data-nombre="@solicitud.Titulo"
                                        title="Eliminar">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!Model.Solicitudes.Any())
                    {
                        <tr>
                            <td colspan="8" class="sin-registros">
                                No hay solicitudes registradas.
                            </td>
                        </tr>
                    }

                    @{
                        int filasVacias = Model.TamanoPagina - Math.Max(Model.Solicitudes.Count(), 1);
                    }

                    @for (var i = 0; i < filasVacias; i++)
                    {
                        <tr class="fila-vacia" aria-hidden="true">
                            <td colspan="8"></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="paginacion paginacion-centrada">
                @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                {
                    <a asp-page="/MantenimientoSolicitudes/Index"
                       asp-route-PageNumber="@pagina"
                       class="pagina @(pagina == Model.PageNumber ? "pagina-activa" : string.Empty)">
                        @pagina
                    </a>
                }
            </div>
        }
    </div>
</section>

<form method="post"
      asp-page-handler="Eliminar"
      asp-route-PageNumber="@Model.PageNumber"
      id="formEliminar">

    <input type="hidden"
           name="idSolicitud"
           id="idSolicitudEliminar" />
</form>

<form method="post"
      asp-page-handler="ActualizarPublicacion"
      asp-route-PageNumber="@Model.PageNumber"
      id="formPublicacion">

    <input type="hidden"
           name="idSolicitud"
           id="idSolicitudPublicacion" />

    <input type="hidden"
           name="publicada"
           id="publicadaSolicitud" />

    <input type="hidden"
           name="fechaVencimientoPublicacion"
           id="fechaVencimientoPublicacion" />
</form>

@section Scripts {
    <script>
        document.querySelectorAll(".boton-publicar").forEach(boton => {
            boton.addEventListener("click", async () => {
                const resultado = await Swal.fire({
                    title: "Publicar solicitud",
                    text: "Indique la fecha de vencimiento de la publicacion.",
                    input: "date",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Publicar",
                    cancelButtonText: "Cancelar",
                    inputValidator: valor => {
                        if (!valor) {
                            return "Debe indicar la fecha de vencimiento de la publicacion.";
                        }
                    }
                });

                if (!resultado.isConfirmed) {
                    return;
                }

                document.getElementById("idSolicitudPublicacion").value = boton.dataset.id;
                document.getElementById("publicadaSolicitud").value = "true";
                document.getElementById("fechaVencimientoPublicacion").value = resultado.value;

                document.getElementById("formPublicacion").submit();
            });
        });

        document.querySelectorAll(".boton-despublicar").forEach(boton => {
            boton.addEventListener("click", () => {
                Swal.fire({
                    title: "Retirar publicacion",
                    text: "¿Desea dejar de publicar esta solicitud?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Si",
                    cancelButtonText: "No"
                }).then(resultado => {
                    if (!resultado.isConfirmed) {
                        return;
                    }

                    document.getElementById("idSolicitudPublicacion").value = boton.dataset.id;
                    document.getElementById("publicadaSolicitud").value = "false";
                    document.getElementById("fechaVencimientoPublicacion").value = "";

                    document.getElementById("formPublicacion").submit();
                });
            });
        });

        document.querySelectorAll(".boton-eliminar").forEach(boton => {
            boton.addEventListener("click", () => {
                Swal.fire({
                    title: "Confirmar eliminacion",
                    text: "¿Realmente desea eliminar el elemento seleccionado?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Si",
                    cancelButtonText: "No"
                }).then(resultado => {
                    if (!resultado.isConfirmed) {
                        return;
                    }

                    document.getElementById("idSolicitudEliminar").value = boton.dataset.id;
                    document.getElementById("formEliminar").submit();
                });
            });
        });

        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
        {
                <text>
                        Swal.fire({
                            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Mensaje)),
                            icon: '@Model.TipoMensaje',
                            confirmButtonText: 'Aceptar'
                        });
                </text>
        }
    </script>
}