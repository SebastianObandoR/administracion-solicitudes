@page
@model AdministracionSolicitudes.Web.Pages.Tareas.FormularioModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = Model.IdTarea.HasValue ? "Editar Tarea" : "Nueva Tarea";
}

<section class="formulario-mantenimiento">
    <div class="acciones-formulario">
        <a asp-page="/Tareas/Index" asp-route-idSolicitud="@Model.IdSolicitud" class="boton-formulario" title="Regresar">
            <i class="bi bi-arrow-left"></i>
        </a>

        <button type="submit" form="formTarea" class="boton-formulario" title="Guardar">
            <i class="bi bi-floppy-fill"></i>
        </button>
    </div>

    <div class="panel-formulario">
        <div class="titulo-panel">Formulario Tarea - @Model.Solicitud.ConsecutivoOficio</div>

        <form method="post" id="formTarea" class="campos-formulario">
            <div class="campo-formulario">
                <label asp-for="Entrada.Descripcion">Descripción de la tarea</label>
                <input asp-for="Entrada.Descripcion" autocomplete="off" />
                <span asp-validation-for="Entrada.Descripcion" class="text-danger"></span>
            </div>

            <div class="campo-formulario">
                <label asp-for="Entrada.Fecha">Fecha</label>
                <input asp-for="Entrada.Fecha" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="Entrada.Fecha" class="text-danger"></span>
            </div>

            <div class="campo-formulario">
                <label asp-for="Entrada.IdUsuario">Usuario</label>
                <select asp-for="Entrada.IdUsuario"
                        asp-items="@(new SelectList(Model.Usuarios, "IdUsuario", "NombreCompleto"))">
                    <option value="">Seleccione un usuario</option>
                </select>
                <span asp-validation-for="Entrada.IdUsuario" class="text-danger"></span>
            </div>

            <div class="campo-formulario">
                <label asp-for="Entrada.HorasInvertidas">Horas invertidas</label>
                <input asp-for="Entrada.HorasInvertidas" type="number" step="0.25" min="0.01" />
                <span asp-validation-for="Entrada.HorasInvertidas" class="text-danger"></span>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <script>
            Swal.fire({
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeError)),
                icon: "error",
                confirmButtonText: "Aceptar"
            });
        </script>
    }
}